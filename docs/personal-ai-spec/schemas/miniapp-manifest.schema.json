{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai.local/schemas/miniapp-manifest.schema.json",
  "title": "Personal AI Shell Mini App Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "entry",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "name": {
      "$ref": "#/$defs/localizedText"
    },
    "description": {
      "$ref": "#/$defs/localizedText"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "icon": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "material"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "remote"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "featureId"
          ],
          "properties": {
            "type": {
              "const": "native"
            },
            "featureId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]+$"
            },
            "initialRoute": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "documentUrl",
            "initialRoute"
          ],
          "properties": {
            "type": {
              "const": "sdui"
            },
            "documentUrl": {
              "type": "string",
              "format": "uri-reference"
            },
            "initialRoute": {
              "type": "string",
              "minLength": 1
            },
            "componentVersion": {
              "type": "string",
              "default": "1.0"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "allowedOrigins"
          ],
          "properties": {
            "type": {
              "const": "web"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "allowedOrigins": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "messageProtocolVersion": {
              "type": "string",
              "default": "1.0"
            }
          }
        }
      ]
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeCards": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/commandContribution"
          }
        },
        "composerActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "activityRenderers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "settingsSections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "notificationRoutes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "enum": [
              "hermes.sessions.read",
              "hermes.sessions.write",
              "hermes.runs.create",
              "hermes.runs.read",
              "hermes.runs.steer",
              "hermes.runs.interrupt",
              "hermes.approvals.respond",
              "hermes.jobs.read",
              "hermes.jobs.manage",
              "hermes.memory.read",
              "hermes.memory.write",
              "hermes.files.read",
              "hermes.files.write",
              "device.camera",
              "device.photos",
              "device.files",
              "device.microphone",
              "device.notifications",
              "device.share.receive",
              "external.openUrl"
            ]
          },
          {
            "type": "string",
            "pattern": "^plugin\\.api:[a-z][a-z0-9.-]+(?::[a-z0-9._-]+)?$"
          }
        ]
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cachePolicy": {
          "enum": [
            "none",
            "metadata",
            "content"
          ]
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000
        },
        "allowDrafts": {
          "type": "boolean"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifestSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "bundleSha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "additionalProperties": false
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]+$"
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "renderer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commandContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]+$"
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    }
  }
}
