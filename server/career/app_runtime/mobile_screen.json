{
  "title": "マイページの確認",
  "components": [
    {"type":"Section","title":"確認する企業","children":[
      {"type":"KeyValue","label":"企業","value":"$company_name"},
      {"type":"Status","text":"$status_text","tone":"$status_tone"},
      {"type":"Text","text":"確認は手動で開始します。ログイン情報とブラウザの許可は既存の設定を使います。"}
    ]},
    {"type":"Column","children":[
      {"type":"Button","label":"マイページを確認","action":"mypage.check","enabled":"$can_check"},
      {"type":"Button","label":"表示を更新","action":"refresh","enabled":true},
      {"type":"Button","label":"マイページの設定","action":"native.settings","enabled":true},
      {"type":"Button","label":"内部ブラウザを開く","action":"native.browser","enabled":true}
    ]}
  ]
}
