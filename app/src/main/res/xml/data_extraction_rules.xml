<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Terminal saved inputs and passwords: Keystore-bound, phone-local only. -->
        <exclude domain="sharedpref" path="hermes_terminal_snippets.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hermes_terminal_snippets.xml"/>
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>